    "    ('mora_comercial', 'Comercial', AMARILLO),\n",
    "    ('mora_vivienda',  'Vivienda',  VERDE),\n",
    "    ('mora_total',     'Total',     TEXT_MUTED),\n",
    "]\n",
    "for col, label, color in carteras:\n",
