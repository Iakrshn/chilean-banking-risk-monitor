   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "fig = plt.figure(figsize=(16, 10))\n",
    "gs  = gridspec.GridSpec(2, 1, hspace=0.08)\n",
    "ax1 = fig.add_subplot(gs[0])\n",
    "ax2 = fig.add_subplot(gs[1], sharex=ax1)\n",
    "\n",
    "# Panel superior: Morosidad del sistema\n",
    "sombrear_ciclos(ax1, df_sistema)\n",
    "ax1.plot(df_sistema['fecha'], df_sistema['mora_total'],\n",
    "         color=ROJO, lw=2.2, label='Mora Total Sistema', zorder=3)\n",
    "ax1.fill_between(df_sistema['fecha'], df_sistema['mora_total'],\n",
    "                 alpha=0.15, color=ROJO)\n",
    "ax1.set_ylabel('Índice de Morosidad 90+ días (%)', fontsize=10)\n",
    "ax1.set_title(\n",
    "    'Sistema Bancario Chileno — Evolución del Riesgo de Crédito (2015–2025)\\n'\n",
    "    'Fuente: CMF Chile & Banco Central de Chile',\n",
    "    fontsize=12, pad=10\n",
    ")\n",
    "ax1.yaxis.set_major_formatter(mticker.FormatStrFormatter('%.1f%%'))\n",
    "ax1.legend(loc='upper left', fontsize=9)\n",
    "plt.setp(ax1.get_xticklabels(), visible=False)\n",
    "\n",
    "# Anotaciones de eventos clave\n",
    "eventos = [\n",
    "    ('2019-10-18', 'Estallido\\nSocial', AMARILLO),\n",
    "    ('2020-03-18', 'COVID-19\\nCuarentena', ROJO),\n",
    "    ('2021-07-01', 'Inicio\\nAlza TPM', NARANJA),\n",
    "    ('2023-08-01', 'Inicio\\nBaja TPM', VERDE),\n",
    "]\n",
    "for fecha, texto, color in eventos:\n",
    "    ax1.axvline(pd.Timestamp(fecha), color=color, lw=1.2, ls='--', alpha=0.8)\n",
    "    mora_val = df_sistema.loc[\n",
    "        df_sistema['fecha'] >= pd.Timestamp(fecha), 'mora_total'\n",
    "    ].iloc[0] if len(df_sistema.loc[df_sistema['fecha'] >= pd.Timestamp(fecha)]) > 0 else 2\n",
    "    ax1.text(pd.Timestamp(fecha), mora_val + 0.1, texto,\n",
    "             color=color, fontsize=7.5, ha='left', va='bottom')\n",
    "\n",
    "# Panel inferior: TPM del Banco Central\n",
    "sombrear_ciclos(ax2, df_sistema)\n",
    "ax2.step(df_sistema['fecha'], df_sistema['tpm'],\n",
    "         color=AZUL, lw=2.2, where='post', label='TPM Banco Central', zorder=3)\n",
    "ax2.fill_between(df_sistema['fecha'], df_sistema['tpm'],\n",
    "                 alpha=0.12, color=AZUL, step='post')\n",
    "ax2.set_ylabel('Tasa de Política Monetaria (%)', fontsize=10)\n",
    "ax2.set_xlabel('Fecha', fontsize=10)\n",
    "ax2.yaxis.set_major_formatter(mticker.FormatStrFormatter('%.1f%%'))\n",
    "ax2.legend(loc='upper left', fontsize=9)\n",
    "\n",
    "# Leyenda de ciclos\n",
    "parches = [mpatches.Patch(color=c, alpha=a+0.3, label=k)\n",
    "           for k, (c, a) in CICLO_COLORES.items()]\n",
    "ax1.legend(handles=[ax1.lines[0]] + parches, loc='upper left',\n",
    "           fontsize=8, ncol=2)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig(REPORT_DIR / '01_evolucion_historica.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()"
   ]
  },
