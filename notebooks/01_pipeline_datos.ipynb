   "source": [
    "# Monitor de Riesgo Bancario Chileno\n",
    "## Notebook 1: Pipeline de Datos — CMF + Banco Central de Chile\n",
    "\n",
    "> **Objetivo:** Construir un pipeline reproducible que descargue, limpie e integre datos de riesgo de crédito del sistema bancario chileno desde dos fuentes oficiales:\n",
    "> - **CMF Chile:** Indicadores de morosidad 90+ días, provisiones y cartera vencida por institución\n",
    "> - **Banco Central de Chile (API BDE):** TPM, IMACEC, colocaciones totales y tipo de cambio\n",
    "\n",
    "**Período de análisis:** 2015 – 2025  \n",
    "**Frecuencia:** Mensual  \n",
    "**Autor:** Krishna Bustos\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "## 0. Configuración e Importaciones"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "import time\n",
    "import requests\n",
    "import warnings\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from io import StringIO\n",
    "from pathlib import Path\n",
    "from datetime import datetime\n",
    "from dotenv import load_dotenv\n",
    "\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "# Cargar credenciales desde .env\n",
    "load_dotenv()\n",
    "BCC_USER = os.getenv('BCC_USER')   # tu email registrado en si3.bcentral.cl\n",
    "BCC_PASS = os.getenv('BCC_PASS')   # tu contraseña BDE\n",
    "\n",
    "# Rutas del proyecto\n",
    "ROOT     = Path('..') \n",
    "RAW_DIR  = ROOT / 'data' / 'raw'\n",
    "PROC_DIR = ROOT / 'data' / 'processed'\n",
    "RAW_DIR.mkdir(parents=True, exist_ok=True)\n",
    "PROC_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "print('✓ Librerías cargadas')\n",
    "print(f'✓ Credenciales BCC: {\"OK\" if BCC_USER else \"⚠ No encontradas — revisa el archivo .env\"}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "## 1. API del Banco Central de Chile (BDE)\n",
    "\n",
    "El Banco Central provee una API REST pública (con registro gratuito).  \n",
    "Documentación: https://si3.bcentral.cl/Siete/ES/Siete/API\n",
    "\n",
    "### Series que descargamos\n",
    "\n",
    "| Serie | Código BDE | Descripción |\n",
    "|-------|-----------|-------------|\n",
    "| TPM | F022.TPM.TIN.D001.NO.Z.M | Tasa de Política Monetaria (mensual) |\n",
    "| IMACEC | F032.IMC.IND.Z.Z.2018.Z.M | IMACEC serie encadenada |\n",
    "| Colocaciones totales | F022.COL.TOT.Z.Z.CLP.M | Colocaciones efectivas totales |\n",
    "| IPC | F074.IPC.IND.Z.Z.Z.Z.M | Índice de Precios al Consumidor |\n",
    "| Dólar observado | F073.TCO.PRE.Z.D | Tipo de cambio observado |\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "BDE_URL = 'https://si3.bcentral.cl/SieteRestWS/SieteRestWS.ashx'\n",
    "\n",
    "SERIES_BCC = {\n",
    "    'tpm'            : 'F022.TPM.TIN.D001.NO.Z.M',\n",
    "    'imacec'         : 'F032.IMC.IND.Z.Z.2018.Z.M',\n",
    "    'colocaciones'   : 'F022.COL.TOT.Z.Z.CLP.M',\n",
    "    'ipc'            : 'F074.IPC.IND.Z.Z.Z.Z.M',\n",
    "    'usd_obs'        : 'F073.TCO.PRE.Z.D',\n",
    "}\n",
    "\n",
    "def descargar_serie_bcc(codigo: str, fecha_ini: str = '2015-01-01',\n",
    "                         fecha_fin: str = None) -> pd.DataFrame:\n",
    "    \"\"\"\n",
    "    Descarga una serie de la API BDE del Banco Central de Chile.\n",
    "    \n",
    "    Parámetros\n",
    "    ----------\n",
    "    codigo    : código de serie BDE (ej: 'F022.TPM.TIN.D001.NO.Z.M')\n",
    "    fecha_ini : fecha de inicio en formato 'YYYY-MM-DD'\n",
    "    fecha_fin : fecha de término (por defecto: hoy)\n",
    "    \n",
    "    Retorna\n",
    "    -------\n",
    "    pd.DataFrame con columnas ['fecha', 'valor']\n",
    "    \"\"\"\n",
    "    if fecha_fin is None:\n",
    "        fecha_fin = datetime.today().strftime('%Y-%m-%d')\n",
    "    \n",
    "    params = {\n",
    "        'user'       : BCC_USER,\n",
    "        'pass'       : BCC_PASS,\n",
    "        'function'   : 'GetSeries',\n",
    "        'timeseries' : codigo,\n",
    "        'firstdate'  : fecha_ini,\n",
    "        'lastdate'   : fecha_fin,\n",
    "    }\n",
    "    \n",
    "    resp = requests.get(BDE_URL, params=params, timeout=30)\n",
    "    resp.raise_for_status()\n",
    "    data = resp.json()\n",
    "    \n",
    "    if data.get('Codigo') != 0:\n",
    "        raise ValueError(f\"Error API BCC: {data.get('Descripcion')}\")\n",
    "    \n",
    "    obs = data['Series']['Obs']\n",
    "    df = pd.DataFrame(obs)\n",
    "    df.columns = ['fecha_str', 'valor', 'estado']\n",
    "    df = df[df['estado'] == 'OK'].copy()\n",
    "    df['fecha'] = pd.to_datetime(df['fecha_str'], format='%d-%m-%Y')\n",
    "    df['valor'] = pd.to_numeric(df['valor'], errors='coerce')\n",
    "    return df[['fecha', 'valor']].dropna().reset_index(drop=True)\n",
    "\n",
    "\n",
    "def descargar_todas_las_series(series: dict, fecha_ini: str = '2015-01-01') -> pd.DataFrame:\n",
    "    \"\"\"\n",
    "    Descarga múltiples series BDE y las integra en un único DataFrame mensual.\n",
    "    \"\"\"\n",
    "    dfs = []\n",
    "    for nombre, codigo in series.items():\n",
    "        print(f'  Descargando: {nombre}...', end=' ')\n",
    "        try:\n",
    "            df = descargar_serie_bcc(codigo, fecha_ini=fecha_ini)\n",
    "            # Resamplear a frecuencia mensual (último valor del mes)\n",
    "            df = df.set_index('fecha').resample('ME').last().reset_index()\n",
    "            df = df.rename(columns={'valor': nombre})\n",
    "            dfs.append(df.set_index('fecha'))\n",
    "            print(f'✓ ({len(df)} obs)')\n",
    "        except Exception as e:\n",
    "            print(f'✗ Error: {e}')\n",
    "        time.sleep(0.5)  # respetar rate limit\n",
    "    \n",
    "    return pd.concat(dfs, axis=1).reset_index()\n",
    "\n",
    "\n",
    "print('Descargando series del Banco Central...')\n",
    "df_bcc = descargar_todas_las_series(SERIES_BCC)\n",
    "df_bcc.to_parquet(RAW_DIR / 'bcc_series.parquet', index=False)\n",
    "print(f'\\n✓ Dataset BCC guardado: {df_bcc.shape}')\n",
    "df_bcc.tail()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "## 2. Datos CMF — Morosidad del Sistema Bancario\n",
    "\n",
    "La CMF publica mensualmente el **Indicador de Morosidad 90+ días** por banco, distinguiendo entre:\n",
    "- **Cartera Comercial** (empresas)\n",
    "- **Cartera Consumo** (personas, créditos de consumo)\n",
    "- **Cartera Vivienda** (hipotecarios)\n",
    "\n",
    "Fuente: https://www.cmfchile.cl/portal/estadisticas/617/w3-propertyvalue-28914.html\n",
    "\n",
    "> **Instrucciones de descarga:**  \n",
    "> 1. Ir al link de la CMF  \n",
    "> 2. Descargar archivos Excel para cada año (2015–2025)  \n",
    "> 3. Guardar en `data/raw/cmf_morosidad/`  \n",
    "> La función `parsear_morosidad_cmf()` los procesa automáticamente."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def parsear_morosidad_cmf(directorio: Path) -> pd.DataFrame:\n",
    "    \"\"\"\n",
    "    Parsea todos los archivos Excel de morosidad CMF de un directorio.\n",
    "    Estructura esperada: archivos .xlsx con nombre 'morosidad_YYYY_MM.xlsx'\n",
    "    \n",
    "    Retorna DataFrame con columnas:\n",
    "    fecha | banco | mora_comercial | mora_consumo | mora_vivienda | mora_total\n",
    "    \"\"\"\n",
    "    archivos = sorted(directorio.glob('*.xlsx'))\n",
    "    if not archivos:\n",
    "        print(f'⚠ No se encontraron archivos en {directorio}')\n",
    "        print('  Usando datos de muestra para demostración...')\n",
    "        return _generar_datos_muestra_cmf()\n",
    "    \n",
    "    registros = []\n",
    "    for archivo in archivos:\n",
    "        try:\n",
    "            xls = pd.ExcelFile(archivo)\n",
    "            for sheet in xls.sheet_names:\n",
    "                df_sheet = pd.read_excel(archivo, sheet_name=sheet, header=2)\n",
    "                # Extraer fecha del nombre de archivo\n",
    "                partes = archivo.stem.split('_')\n",
    "                fecha = pd.to_datetime(f\"{partes[1]}-{partes[2]}-01\")\n",
    "                # Renombrar columnas según estructura CMF estándar\n",
    "                df_sheet.columns = df_sheet.columns.str.strip().str.lower()\n",
    "                df_sheet['fecha'] = fecha\n",
    "                registros.append(df_sheet)\n",
    "        except Exception as e:\n",
    "            print(f'  ✗ Error en {archivo.name}: {e}')\n",
    "    \n",
    "    return pd.concat(registros, ignore_index=True) if registros else _generar_datos_muestra_cmf()\n",
    "\n",
    "\n",
    "def _generar_datos_muestra_cmf() -> pd.DataFrame:\n",
    "    \"\"\"\n",
    "    Genera datos de muestra calibrados con valores históricos reales\n",
    "    del sistema bancario chileno (2015-2025).\n",
    "    Útil para ejecutar el notebook antes de descargar los datos CMF.\n",
    "    \"\"\"\n",
    "    np.random.seed(42)\n",
    "    \n",
    "    bancos = {\n",
    "        'Banco de Chile'      : {'base_mora': 1.2, 'vol': 0.15},\n",
    "        'Banco Santander'     : {'base_mora': 1.5, 'vol': 0.18},\n",
    "        'BancoEstado'         : {'base_mora': 2.8, 'vol': 0.25},\n",
    "        'Banco BCI'           : {'base_mora': 1.3, 'vol': 0.16},\n",
    "        'Scotiabank Chile'    : {'base_mora': 2.1, 'vol': 0.22},\n",
    "        'Banco Itaú'          : {'base_mora': 1.8, 'vol': 0.20},\n",
    "        'Banco Security'      : {'base_mora': 1.0, 'vol': 0.12},\n",
    "        'Banco Falabella'     : {'base_mora': 4.5, 'vol': 0.40},\n",
    "        'Banco Ripley'        : {'base_mora': 5.2, 'vol': 0.45},\n",
    "        'Banco Internacional' : {'base_mora': 1.6, 'vol': 0.18},\n",
    "    }\n",
    "    \n",
    "    fechas = pd.date_range('2015-01-01', '2025-01-01', freq='ME')\n",
    "    \n",
    "    # Crear shocks macro calibrados con historia real\n",
    "    # Estallido social Oct 2019, COVID Mar 2020, Ciclo alza TPM 2021-2023\n",
    "    shock = np.ones(len(fechas))\n",
    "    for i, f in enumerate(fechas):\n",
    "        if f >= pd.Timestamp('2019-10-01') and f <= pd.Timestamp('2020-03-01'):\n",
    "            shock[i] = 1.25  # estallido social\n",
    "        elif f >= pd.Timestamp('2020-03-01') and f <= pd.Timestamp('2021-06-01'):\n",
    "            shock[i] = 1.60  # COVID-19\n",
    "        elif f >= pd.Timestamp('2022-01-01') and f <= pd.Timestamp('2023-06-01'):\n",
    "            shock[i] = 1.35  # ciclo inflacionario + alza TPM\n",
    "    \n",
    "    registros = []\n",
    "    for banco, params in bancos.items():\n",
    "        base = params['base_mora']\n",
    "        vol  = params['vol']\n",
    "        mora_total = np.abs(base * shock + np.random.normal(0, vol, len(fechas)))\n",
    "        # Diferencial por cartera (consumo > vivienda > comercial)\n",
    "        for i, fecha in enumerate(fechas):\n",
    "            registros.append({\n",
    "                'fecha'         : fecha,\n",
    "                'banco'         : banco,\n",
    "                'mora_comercial': mora_total[i] * 0.75,\n",
    "                'mora_consumo'  : mora_total[i] * 1.40,\n",
    "                'mora_vivienda' : mora_total[i] * 0.55,\n",
    "                'mora_total'    : mora_total[i],\n",
    "            })\n",
    "    \n",
    "    return pd.DataFrame(registros)\n",
    "\n",
    "\n",
    "print('Procesando datos CMF...')\n",
    "CMF_DIR = RAW_DIR / 'cmf_morosidad'\n",
    "CMF_DIR.mkdir(exist_ok=True)\n",
    "df_cmf = parsear_morosidad_cmf(CMF_DIR)\n",
    "df_cmf.to_parquet(RAW_DIR / 'cmf_morosidad.parquet', index=False)\n",
    "print(f'\\n✓ Dataset CMF: {df_cmf.shape}')\n",
    "print(f'  Bancos: {df_cmf[\"banco\"].nunique()}')\n",
    "print(f'  Período: {df_cmf[\"fecha\"].min().strftime(\"%Y-%m\")} → {df_cmf[\"fecha\"].max().strftime(\"%Y-%m\")}')\n",
    "df_cmf.head()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "## 3. Integración de Fuentes — Dataset Maestro"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def construir_dataset_maestro(df_cmf: pd.DataFrame, df_bcc: pd.DataFrame) -> pd.DataFrame:\n",
    "    \"\"\"\n",
    "    Integra datos CMF (morosidad por banco) con macro del Banco Central.\n",
    "    \n",
    "    Para cada fila de morosidad bancaria, adjunta las variables macro\n",
    "    del mes correspondiente (TPM, IMACEC, IPC, Colocaciones).\n",
    "    \"\"\"\n",
    "    # Normalizar fechas a fin de mes para hacer el join correctamente\n",
    "    df_cmf = df_cmf.copy()\n",
    "    df_cmf['fecha'] = pd.to_datetime(df_cmf['fecha']).dt.to_period('M').dt.to_timestamp('M')\n",
    "    \n",
    "    df_bcc = df_bcc.copy()\n",
    "    df_bcc['fecha'] = pd.to_datetime(df_bcc['fecha']).dt.to_period('M').dt.to_timestamp('M')\n",
    "    \n",
    "    # Merge por fecha (left join: preserva todos los registros de morosidad)\n",
    "    df_master = df_cmf.merge(df_bcc, on='fecha', how='left')\n",
    "    \n",
    "    # Variables derivadas útiles para el análisis\n",
    "    # Variación mensual de colocaciones (proxy de expansión/contracción del crédito)\n",
    "    df_master = df_master.sort_values(['banco', 'fecha'])\n",
    "    df_master['var_colocaciones_m'] = (\n",
    "        df_master.groupby('banco')['colocaciones']\n",
    "        .pct_change() * 100\n",
    "    )\n",
    "    \n",
    "    # Variación anual de morosidad (YoY)\n",
    "    df_master['mora_total_yoy'] = (\n",
    "        df_master.groupby('banco')['mora_total']\n",
    "        .pct_change(12) * 100\n",
    "    )\n",
    "    \n",
    "    # Spread de morosidad vs sistema (diferencial banco vs promedio)\n",
    "    mora_sistema = df_master.groupby('fecha')['mora_total'].transform('mean')\n",
    "    df_master['mora_spread_vs_sistema'] = df_master['mora_total'] - mora_sistema\n",
    "    \n",
    "    # Período del ciclo monetario (para análisis segmentado)\n",
    "    condiciones = [\n",
    "        df_master['fecha'].between('2015-01-01', '2019-09-30'),\n",
    "        df_master['fecha'].between('2019-10-01', '2020-02-28'),\n",
    "        df_master['fecha'].between('2020-03-01', '2021-05-31'),\n",
    "        df_master['fecha'].between('2021-06-01', '2023-07-31'),\n",
    "        df_master['fecha'] >= '2023-08-01',\n",
    "    ]\n",
    "    etiquetas = [\n",
    "        'Pre-Estallido (2015–2019)',\n",
    "        'Estallido Social',\n",
    "        'COVID-19',\n",
    "        'Ciclo Inflacionario / Alza TPM',\n",
    "        'Normalización Monetaria',\n",
    "    ]\n",
    "    df_master['ciclo'] = np.select(condiciones, etiquetas, default='Otro')\n",
    "    \n",
    "    return df_master.reset_index(drop=True)\n",
    "\n",
    "\n",
    "df_master = construir_dataset_maestro(df_cmf, df_bcc)\n",
    "df_master.to_parquet(PROC_DIR / 'dataset_maestro.parquet', index=False)\n",
    "\n",
    "print('✓ Dataset maestro construido')\n",
    "print(f'  Shape: {df_master.shape}')\n",
    "print(f'  Columnas: {list(df_master.columns)}')\n",
    "df_master.describe()"
   ]
  },
  {
   "cell_type": "markdown",
